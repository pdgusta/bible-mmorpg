{
  "name": "a-semente",
  "private": true,
  "version": "0.1.0",
  "description": "A Semente — RPG 3D bíblico de navegador (MVP: Noé → Abraão)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:leve": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "versiculos": "node scripts/extrair-versiculos.mjs",
    "validar": "node scripts/validar-textos.mjs",
    "e2e": "node e2e/jogar-mvp.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "0.186.1"
  }
}
